{
    "slug": "mattermost",
    "container_port": 8065,
    "volume_roles": {
        "data": "/mattermost/data",
        "config": "/mattermost/config",
        "plugins": "/mattermost/plugins",
        "client-plugins": "/mattermost/client/plugins",
        "logs": "/mattermost/logs",
        "db": "/var/lib/postgresql/data"
    },
    "generated_secrets": [
        "DATABASE_PASSWORD"
    ],
    "complex_secrets": [],
    "panel_only_secrets": [],
    "url_env_key": "MM_SERVICESETTINGS_SITEURL",
    "default_memory_limit": "1g",
    "method": "one_click",
    "serving_profile": "docker",
    "needs_database": false,
    "features": [
        "app_dashboard",
        "app_domain",
        "app_log",
        "app_backup",
        "app_file",
        "app_security",
        "app_firewall",
        "app_bot_blocker",
        "app_fail2ban",
        "app_container",
        "app_compose"
    ],
    "category": "communication",
    "icon": "mattermost",
    "popular": true,
    "fields": [
        {
            "name": "memory_limit",
            "label": "Memory limit",
            "type": "text",
            "required": false,
            "advanced": false,
            "placeholder": "1g",
            "help": "Optional. The most memory this app's own container may use. Left empty it gets 1g, which is what this app has been measured to need — set it lower and the app may not start, and it will fail as a 502 with nothing about memory to explain it. Any database this app brings has its own separate ceiling."
        },
        {
            "name": "cpu_limit",
            "label": "CPU limit",
            "type": "text",
            "required": false,
            "advanced": false,
            "placeholder": "No limit",
            "help": "Optional. How many CPU cores this app's own container may use — 1 for one full core, 0.5 for half. This server has 4, and Docker will not start a container asking for more. Left empty there is no CPU limit at all. Going past this does not kill anything; the container waits, so the symptom is slowness rather than an error. Any database this app brings is not limited by it."
        }
    ],
    "rule_keys": [
        "memory_limit",
        "cpu_limit"
    ],
    "starter_files": [],
    "first_run_claim": null,
    "volume_mounts": [
        {
            "volume": "sv-app-4242_data",
            "path": "/mattermost/data"
        },
        {
            "volume": "sv-app-4242_config",
            "path": "/mattermost/config"
        },
        {
            "volume": "sv-app-4242_plugins",
            "path": "/mattermost/plugins"
        },
        {
            "volume": "sv-app-4242_client-plugins",
            "path": "/mattermost/client/plugins"
        },
        {
            "volume": "sv-app-4242_logs",
            "path": "/mattermost/logs"
        },
        {
            "volume": "sv-app-4242_db",
            "path": "/var/lib/postgresql/data"
        }
    ],
    "docker_secret_keys": [
        "DATABASE_PASSWORD"
    ],
    "installer": "App\\Services\\Server\\Applications\\Installers\\DockerAppInstaller",
    "catalog": {
