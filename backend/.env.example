APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Frontend origin for CORS (production/deployed frontend URL), e.g. https://app.example.com
FRONTEND_URL=

# Days until an issued auth token (Bearer or session) expires
TOKEN_EXPIRATION_DAYS=10

# White-label branding returned by GET /api/branding (all optional, default to ServerAvatar's own)
# BRANDING_NAME=ServerAvatar
# BRANDING_LOGO=
# BRANDING_LOGO_DARK=
# BRANDING_ICON=
# BRANDING_ICON_DARK=
# BRANDING_FAVICON=
# BRANDING_PRIMARY_COLOR=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# The server-operations log records every command the panel runs, so it is the
# fastest-growing file on a busy box. Rotated daily and kept this many days.
LOG_SERVER_OPS_DAYS=30

DB_CONNECTION=sqlite

# SQLite concurrency. WAL lets readers and one writer work at the same time;
# without it a second concurrent request gets "database is locked" and a 500,
# which every page load triggers because the rate limiter writes on each
# request. Ignored by the mysql/pgsql drivers.
DB_JOURNAL_MODE=WAL
DB_SYNCHRONOUS=NORMAL
DB_BUSY_TIMEOUT=15000
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Domains allowed to authenticate via cookie/session (Sanctum). Add the
# frontend's host (no scheme/port) here once deployed, e.g. app.example.com
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:5173

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Redis when available; falls back cleanly to `database` (SQLite + WAL) on a
# box without it. The rate limiter writes on EVERY api request, so on SQLite
# this is the single hottest write in the app.
CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Panel self-update. install.sh writes all of these with the real values for
# the install it just made — they only need setting by hand on a panel that was
# not installed by it. The version itself is NOT here: it comes from the VERSION
# file at the repository root, so it ships with the code rather than drifting
# from it. Set APP_VERSION only to override that (a packaged or pinned build).
#
# Every key here carries a real value on purpose. `KEY=` in a .env file reads
# back as an empty string, not as absent, so it would override the config
# default instead of falling through to it — an empty PANEL_RELEASES_URL means
# the update check silently requests nothing.
PANEL_UPDATE_STATE_DIR=/var/lib/panel-update
PANEL_PHP_VERSION=8.4
PANEL_PHP_FPM_SERVICE=php8.4-fpm
PANEL_FRONTEND_SERVICE=panel-frontend.service
PANEL_QUEUE_SERVICE=panel-queue.service
PANEL_NODE_BIN_DIR=/opt/fnm/aliases/default/bin

# Requests per minute per authenticated user (per IP for guests) across the
# whole API. A per-route throttle stacks with this rather than replacing it,
# so the lower of the two always wins.
RATE_LIMIT_API=180
RATE_LIMIT_GUEST=20

# The central panel's own budget. It authenticates as a single machine account
# for every site it manages on this server, so it would otherwise share one
# user's allowance. Deliberately high, and deliberately not unlimited.
RATE_LIMIT_CENTRAL=3000

# Progress feeds only — provisioning, deploys, sync runs, panel updates. These
# are exempt from RATE_LIMIT_API rather than sharing it, so this number is the
# whole budget for them and is not capped by the one above. Per user, per
# polled resource.
RATE_LIMIT_PROGRESS=600
