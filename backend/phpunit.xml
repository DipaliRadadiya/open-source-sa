<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <!-- The encrypted cast (GitAccount::token, StorageDestination::access_key + secret_key,
             Application::webhook_secret) needs a 32-byte key. A static, fixture-only key
             used solely inside the test env means a leaked ciphertext from a test run cannot
             decrypt any other row, anywhere. -->
        <env name="APP_KEY" value="base64:oJWd0mTT0XuR0Wvpr1QBpOauWIc3ZvDL0VVjBpMYDvk="/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <!-- Feature tests assert on the exact command a feature runs. A sudo
             prefix on every one of them would assert the prefix instead.
             ServerOpsPrivilegeTest enables it and covers the prefixing. -->
        <env name="SERVER_OPS_SUDO" value="false"/>
        <!-- A version counts as installed only when its FPM binary is really
             there, which is what stops a removed version lingering on the PHP
             screen. Every suite that fakes `php_dir` invents versions this
             machine does not have, and none of them are about detection, so
             the check is pointed at a path that always exists. `{version}`
             never appears in it, so it resolves the same for any version.
             FpmPhpStackDetectionTest overrides this to assert the real rule. -->
        <env name="SERVER_PHP_FPM_BINARY_PATTERN" value="/bin/sh"/>
        <!-- Keep test runs out of the real operations log. Left alone the
             suite appended ~570k lines to it. `single` (not daily) so a test
             that reads the file knows its exact name. -->
        <env name="LOG_SERVER_OPS_DRIVER" value="single"/>
        <env name="LOG_SERVER_OPS_PATH" value="storage/framework/testing/server-ops.log"/>
        <env name="SESSION_DRIVER" value="array"/>
        <!-- Tests run on the localhost host; the real .env pins SESSION_DOMAIN
             to the deployed parent domain, which wouldn't match here and
             would break cookie-session auth assertions. -->
        <env name="SESSION_DOMAIN" value="null"/>
        <env name="FRONTEND_URL" value=""/>
        <env name="SANCTUM_STATEFUL_DOMAINS" value="localhost,localhost:3000,127.0.0.1,127.0.0.1:8000,::1"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
